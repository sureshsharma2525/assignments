aws_region = "us-east-1"
instances = {
  ec2-01 = {
    instance_type = "t3.micro"
    root_volume = {
      type = "gp3"
      size = 20
    }
    key_name = "key-ec2"
  }

  ec2-02 = {
    instance_type = "t3.small"
    root_volume = {
      type = "gp3"
      size = 30
    }
    key_name = "key-dev"
  }

  ec2-03 = {
    instance_type = "t3.medium"
    root_volume = {
      type = "io1"
      size = 40
    }
    key_name = "key-prod"
  }
  ec2-04 = {
    instance_type = "t2.micro"
    root_volume = {
      type = "gp2"
      size = 25
    }
    key_name = "key-test"
  }
  ec2-05 = {
    instance_type = "t3.large"
    root_volume = {
      type = "gp3"
      size = 50
    }
    key_name = "key-admin"
  }
}